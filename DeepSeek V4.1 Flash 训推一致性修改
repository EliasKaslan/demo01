```diff
@@ -98,9 +98,9 @@ def get_offload_policy(fsdp_plan: FSDPPlanConfig):
 def get_fsdp_modules(model: torch.nn.Module, fsdp_plan: FSDPPlanConfig, ignored_modules: Set[str]) -> dict[Any, Any]:
